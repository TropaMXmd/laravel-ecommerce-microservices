{
	"name": "ecomstarter/core",
	"description": "Shared core utilities for Ecomstarter microservices",
	"type": "library",
	"version": "1.0.0",
	"require": {
		"php": "^8.3",
		"illuminate/support": "^13.0",
		"illuminate/http": "^13.0",
		"illuminate/log": "^13.0",
		"illuminate/routing": "^13.0",
		"illuminate/database": "^13.0",
		"firebase/php-jwt": "^7.1"
	},
	"autoload": {
		"psr-4": {
			"Ecomstarter\\Core\\": "src/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Ecomstarter\\Core\\CoreServiceProvider"
			]
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true
}
